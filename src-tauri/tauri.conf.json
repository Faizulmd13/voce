{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voce",
  "version": "0.1.0",
  "identifier": "ai.voce.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voce",
        "url": "/",
        "width": 800,
        "height": 600,
        "minWidth": 700,
        "minHeight": 500,
        "hiddenTitle": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "visible": true
      },
      {
        "label": "stt-overlay",
        "title": "Voce Dictation",
        "url": "/dictation",
        "width": 350,
        "height": 80,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "translate-overlay",
        "title": "Voce Translation",
        "url": "/translation",
        "width": 550,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}