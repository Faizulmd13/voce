# ==============================================================================
# Voce AI Desktop - Environment Variables Template
# Copy this file to .env and populate your personal API keys & OAuth credentials.
# ==============================================================================

# Groq Cloud API (Optional - can also be configured directly in the app settings)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Google OAuth 2.0 Credentials (for Google Drive Sync & Bookmark Vault)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Ensure redirect URI http://127.0.0.1:14321 is authorized
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Anonymous Firebase Telemetry (Optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=voce-desktop.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=voce-desktop
VITE_FIREBASE_STORAGE_BUCKET=voce-desktop.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
